# Impose backend env template. Copy the half you need next to its server.py
# (box vars to backend/lightning/.env on the Studio, relay vars to the
# Render dashboard). Never commit real values. chmod 600 the real file.
#
# ---------- GPU box gateway (backend/lightning/) ----------
CONTROL_KEY=
LLM_BASE_URL=http://127.0.0.1:8080
LLM_API_KEY=
LLM_MODEL=models/Qwen3-Coder-30B-A3B-Instruct-Q3_K_M.gguf
LLM_ALIAS=qwen3-coder-30b
LLM_CONTEXT=16384
LLM_NGL=44
START_LLM=1
PORT=9000
ALLOWED_ORIGINS=*
SEARCH_PROVIDERS=duckduckgo,wikipedia
TAVILY_API_KEY=
BRAVE_API_KEY=
SERPER_API_KEY=
#
# ---------- Always-on relay (backend/relay/), optional layer 2 ----------
# CONTROL_KEY=            (its own key, the one browsers use)
# LLM_GATEWAY_URL=        (the box gateway root, no /v1, e.g. https://9000-xxxx.cloudspaces.litng.ai)
# LLM_GATEWAY_KEY=        (the box CONTROL_KEY)
# ALLOWED_ORIGINS=*
# PORT=8000
# WAKE_STUDIO=0
# WAKE_ON_CHAT=1
# IDLE_MONITOR=1
# IDLE_STOP_MINUTES=5
# IDLE_CHECK_MINUTES=5
# LIGHTNING_API_KEY=
# LIGHTNING_USER_ID=
# LIGHTNING_USERNAME=
# LIGHTNING_STUDIO=
# LIGHTNING_TEAMSPACE=
# LIGHTNING_MACHINE=T4
