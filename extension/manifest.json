{
  "manifest_version": 3,
  "name": "Nova Agent Bridge",
  "version": "0.1.0",
  "description": "Lets the Nova web app read pages and perform your approved actions in logged-in tabs. Never sees passwords.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Nova Agent Bridge",
    "default_popup": "popup.html"
  },
  "permissions": ["tabs", "storage"],
  "host_permissions": [
    "https://impose-web.onrender.com/*",
    "https://x.com/*",
    "https://twitter.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://impose-web.onrender.com/*"],
      "js": ["content/nova-bridge.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["content/x-actions.js"],
      "run_at": "document_idle"
    }
  ]
}
