{
  "manifest_version": 3,
  "name": "Impose Agent Bridge",
  "version": "0.2.0",
  "description": "Executes user-approved browser plans in signed-in tabs without reading passwords or payment fields.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Impose Agent Bridge",
    "default_popup": "popup.html"
  },
  "permissions": ["tabs", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://impose-web.onrender.com/*"],
      "js": ["content/impose-bridge.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content/generic-actions.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["content/x-actions.js"],
      "run_at": "document_idle"
    }
  ]
}
