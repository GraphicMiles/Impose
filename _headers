# Static-host custom headers mirror. The CSP reduces the impact of XSS bugs:
# scripts only from this origin, the analytics beacon, and the single inline
# boot script in index.html by exact content hash. If that script changes,
# recompute its hash:
#   python3 -c "import base64,hashlib,re;print(['sha256-'+base64.b64encode(hashlib.sha256(b).digest()).decode() for b in re.findall(rb'<script>(.*?)</script>', open('index.html','rb').read(), re.S)])"
# Render does not read this Netlify-style file; the same rules live in
# render.yaml for the deployed site. Keep the two in step.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-0veUJDTsBMiTL9D+bxTQUQaWGGcKCSOgssmNQiYop6s=' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self'; connect-src 'self' https: http: localhost http://127.0.0.1 ws: wss:; frame-src https://www.youtube-nocookie.com https://player.twitch.tv https://clips.twitch.tv; object-src 'none'; base-uri 'self'; form-action 'self'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(self), geolocation=()
